# NeuralGrid API
NEURALGRID_API_HOST=0.0.0.0
NEURALGRID_API_PORT=8000
NEURALGRID_ENV=demo
NEURALGRID_DB_PATH=data/neuralgrid.db
NEURALGRID_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NEURALGRID_DEFAULT_SEED=42
NEURALGRID_TICK_INTERVAL_SECONDS=1.5

# EventSense
EVENTSENSE_ENABLED=true
EVENTSENSE_ENABLE_GDELT=true
EVENTSENSE_ENABLE_RSS=true
EVENTSENSE_ENABLE_CRAWL4AI=true
EVENTSENSE_MAX_CANDIDATES=5
EVENTSENSE_MAX_CRAWL_PAGES=5
EVENTSENSE_CRAWL_TIMEOUT_SECONDS=30
EVENTSENSE_CRAWL_CONCURRENCY=1
EVENTSENSE_MIN_DOMAIN_DELAY_SECONDS=3
EVENTSENSE_CHECK_ROBOTS=true
EVENTSENSE_USER_AGENT=NeuralGridEventSense/0.1
EVENTSENSE_MAX_TEXT_BYTES=200000
EVENTSENSE_ALLOWED_DOMAINS=replace-with-approved-domain-list
EVENTSENSE_RSS_FEEDS=replace-with-approved-feed-list
GDELT_ENABLED=true
GDELT_TIMESPAN=7d
GDELT_MAX_RECORDS=10
GDELT_MIN_INTERVAL_SECONDS=6

# Demo fallback
EVENTSENSE_ALLOW_SEEDED_FALLBACK=true
DEMO_EVENT_ID=palace-grounds-demo

# TwinNode - local private network only
TWINNODE_CONTROLLER_URL=http://<TANISH_PRIVATE_IP>:8000
TWINNODE_AGENT_HOST=0.0.0.0
TWINNODE_AGENT_PORT=8101
TWINNODE_NODE_ID=NODE-JUNAID
TWINNODE_NODE_TOKEN=GENERATE_A_RANDOM_LOCAL_TOKEN
TWINNODE_NODE_TOKENS={"NODE-TANISH":"dev-token-tanish","NODE-JUNAID":"dev-token-junaid"}
TWINNODE_HEARTBEAT_INTERVAL_SECONDS=2.0
TWINNODE_HEARTBEAT_TIMEOUT_SECONDS=10.0
TWINNODE_TASK_LEASE_SECONDS=30.0
TWINNODE_MAX_RETRIES=2
